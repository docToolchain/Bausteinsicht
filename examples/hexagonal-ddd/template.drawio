<mxfile host="Bausteinsicht" compressed="false" type="device">
  <diagram id="hexagonal-ddd-template" name="Template">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Relationship style -->
        <mxCell id="template-relationship" bausteinsicht_template="relationship" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Actor (person) -->
        <object label="" bausteinsicht_template="actor" id="tpl-actor">
          <mxCell parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1">
            <mxGeometry width="40" height="80" as="geometry" />
          </mxCell>
        </object>

        <!-- Data store (cylinder) -->
        <object label="" bausteinsicht_template="datastore" id="tpl-datastore">
          <mxCell parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1">
            <mxGeometry width="100" height="90" as="geometry" />
          </mxCell>
        </object>

        <!-- ===== Driving side (blue = adapter zone) ===== -->
        <object label="" bausteinsicht_template="drivingAdapter" id="tpl-drivingAdapter">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1">
            <mxGeometry width="170" height="60" as="geometry" />
          </mxCell>
        </object>

        <!-- Inbound port (orange = port zone, hexagon = the hexagon's edge) -->
        <object label="" bausteinsicht_template="inboundPort" id="tpl-inboundPort">
          <mxCell parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1">
            <mxGeometry width="160" height="70" as="geometry" />
          </mxCell>
        </object>

        <!-- ===== Application core (grey) ===== -->
        <object label="" bausteinsicht_template="applicationService" id="tpl-applicationService">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1">
            <mxGeometry width="180" height="60" as="geometry" />
          </mxCell>
        </object>

        <!-- ===== Domain core (green = domain zone) ===== -->
        <object label="" bausteinsicht_template="aggregate" id="tpl-aggregate">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;verticalAlign=top;fontSize=12;" vertex="1">
            <mxGeometry width="220" height="130" as="geometry" />
          </mxCell>
        </object>
        <object label="" bausteinsicht_template="entity" id="tpl-entity">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1">
            <mxGeometry width="150" height="40" as="geometry" />
          </mxCell>
        </object>
        <object label="" bausteinsicht_template="valueObject" id="tpl-valueObject">
          <mxCell parent="1" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=2;" vertex="1">
            <mxGeometry width="150" height="40" as="geometry" />
          </mxCell>
        </object>
        <object label="" bausteinsicht_template="domainService" id="tpl-domainService">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=2;" vertex="1">
            <mxGeometry width="170" height="50" as="geometry" />
          </mxCell>
        </object>

        <!-- ===== Driven side ===== -->
        <object label="" bausteinsicht_template="outboundPort" id="tpl-outboundPort">
          <mxCell parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1">
            <mxGeometry width="160" height="70" as="geometry" />
          </mxCell>
        </object>
        <object label="" bausteinsicht_template="drivenAdapter" id="tpl-drivenAdapter">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1">
            <mxGeometry width="180" height="60" as="geometry" />
          </mxCell>
        </object>

        <!-- ===== Outside the hexagon ===== -->
        <object label="" bausteinsicht_template="externalSystem" id="tpl-externalSystem">
          <mxCell parent="1" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1">
            <mxGeometry width="170" height="70" as="geometry" />
          </mxCell>
        </object>

        <!-- Bounded context as a plain element (used in the context view) -->
        <object label="" bausteinsicht_template="boundedContext" id="tpl-boundedContext">
          <mxCell parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontStyle=1;verticalAlign=top;fontSize=13;" vertex="1">
            <mxGeometry width="240" height="140" as="geometry" />
          </mxCell>
        </object>

        <!-- ===== Boundary styles (used when a container is a view scope) ===== -->
        <!-- Bounded-context boundary rendered as a HEXAGON container, so the
             ports-and-adapters view frames the application core as a hexagon. -->
        <object label="Bounded Context" bausteinsicht_template="boundedContext_boundary" id="tpl-boundedContext-boundary">
          <mxCell parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontColor=#333333;fontStyle=1;verticalAlign=top;container=1;collapsible=0;fontSize=14;" vertex="1">
            <mxGeometry width="680" height="460" as="geometry" />
          </mxCell>
        </object>
        <object label="Aggregate" bausteinsicht_template="aggregate_boundary" id="tpl-aggregate-boundary">
          <mxCell parent="1" style="swimlane;startSize=26;whiteSpace=wrap;html=1;fillColor=#eef7ec;strokeColor=#82b366;fontColor=#5b8a4a;fontStyle=1;rounded=1;container=1;collapsible=0;fontSize=12;" vertex="1">
            <mxGeometry width="240" height="160" as="geometry" />
          </mxCell>
        </object>

        <!-- ===== Zone containers (concentric rings, "nested" layout) ===== -->
        <object label="" bausteinsicht_template="adapterZone" id="tpl-adapterZone">
          <mxCell parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#3b5b8c;fontStyle=1;verticalAlign=top;container=1;collapsible=0;fontSize=13;" vertex="1">
            <mxGeometry width="760" height="520" as="geometry" />
          </mxCell>
        </object>
        <object label="" bausteinsicht_template="portZone" id="tpl-portZone">
          <mxCell parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#b06a00;fontStyle=1;verticalAlign=top;container=1;collapsible=0;fontSize=13;" vertex="1">
            <mxGeometry width="560" height="400" as="geometry" />
          </mxCell>
        </object>
        <object label="" bausteinsicht_template="domainZone" id="tpl-domainZone">
          <mxCell parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#4a7a3a;fontStyle=1;verticalAlign=top;container=1;collapsible=0;fontSize=13;" vertex="1">
            <mxGeometry width="340" height="260" as="geometry" />
          </mxCell>
        </object>

        <!-- Zone boundaries (used when a zone container is a view scope) -->
        <object label="Adapters" bausteinsicht_template="adapterZone_boundary" id="tpl-adapterZone-b">
          <mxCell parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#3b5b8c;fontStyle=1;verticalAlign=top;container=1;collapsible=0;fontSize=13;" vertex="1">
            <mxGeometry width="760" height="520" as="geometry" />
          </mxCell>
        </object>
        <object label="Ports" bausteinsicht_template="portZone_boundary" id="tpl-portZone-b">
          <mxCell parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#b06a00;fontStyle=1;verticalAlign=top;container=1;collapsible=0;fontSize=13;" vertex="1">
            <mxGeometry width="560" height="400" as="geometry" />
          </mxCell>
        </object>
        <object label="Domain Core" bausteinsicht_template="domainZone_boundary" id="tpl-domainZone-b">
          <mxCell parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#4a7a3a;fontStyle=1;verticalAlign=top;container=1;collapsible=0;fontSize=13;" vertex="1">
            <mxGeometry width="340" height="260" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
